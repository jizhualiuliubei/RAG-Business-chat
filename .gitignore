!/showcase/assets/screenshots/*.webp
!/showcase/assets/screenshots/*.png
!/showcase/assets/screenshots/*.jpg
!/showcase/assets/screenshots/*.jpeg
!/showcase/assets/screenshots/*.gif
!/showcase/assets/screenshots/*.avif
!/showcase/assets/screenshots/*.ico
!/showcase/assets/screenshots/*.svg
/showcase/assets/diagrams/*
