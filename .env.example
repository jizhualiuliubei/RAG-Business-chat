# =========================================================
# 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填入你的真实 API Key
#   cp .env.example .env
# 注意：.env 不要提交到 GitHub（包含敏感信息）
# =========================================================

# ============ DeepSeek（对话模型）============
DEEPSEEK_API_KEY=sk-你的deepseek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============ 硅基流动（嵌入模型 BGE-M3）============
SILICONFLOW_API_KEY=sk-你的硅基流动密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ============ Milvus 向量数据库 ============
# 本地 Milvus：MILVUS_URI=http://localhost:19530，MILVUS_TOKEN 留空
# Zilliz Cloud：MILVUS_URI 填公共 Endpoint，MILVUS_TOKEN 填 API Key 或 username:password
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=kb_qa
# 向量集合名。多环境必须各用一个名字（线上 knowledge_chunks、本地 knowledge_chunks_local）：
# 向量主键是 doc_id×100000+chunk_index，而 doc_id 由各环境自己的数据库独立分配，共用集合会互相覆盖，
# 表现为「文档状态显示已完成、但检索不到任何内容」，且界面完全看不出异常。
MILVUS_COLLECTION=knowledge_chunks

# ============ 关系数据库（MySQL / SQLite 可切换）============
# DB_DRIVER=mysql 走 MySQL（需填下面连接）；=sqlite 走 SQLite（零配置）
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=你的端口
DB_USER=你的mysql用户名
DB_PASSWORD=你的mysql密码
DB_NAME=kb_qa
# MySQL 连接池。线上 2核4G 建议保持下面默认值，避免批量上传时连接等待过早超时。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=60

# ============ 应用配置 ============
# 嵌入模型（免费版用 BAAI/bge-m3，收费增强版用 Pro/BAAI/bge-m3）
EMBED_MODEL_NAME=BAAI/bge-m3
# 向量维度（BGE-M3 = 1024）
EMBED_DIM=1024
# 超长章节的二级细分参数（主策略是整章独立成块，只有单章超过
# MAX_CHAPTER_LEN=1200 字符时才会用这两个值再切）
CHUNK_SIZE=350
CHUNK_OVERLAP=80
# 检索参数
TOP_K=5
# 相似度阈值。注意：融合分是"两个通道各自 min-max 归一化后的加权和"，
# 所以它不是绝对相似度，而是相对候选集的位置 + 通道权重。
# ⚠️ 不要把它调到高于下面较小的那个通道权重，否则"只被单通道召回"的块
# 会被整体丢掉（库里有却答不出）。当前 0.40 <= min(0.6, 0.4)。
SCORE_THRESHOLD=0.40
# 混合检索融合权重（两个之和必须为 1）。
# 默认向量为主：BM25 走字符 bigram，员工口语提问（"我早上几点到"）与制度正文
# （"弹性到岗范围为8:30-10:00"）几乎没有共同 bigram，此时 BM25 排序基本是噪声，
# 权重给高了会把真正相关的块挤出 Top-K。
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4

# ============ 二阶段重排（rerank） ============
ENABLE_RERANK=true
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=8
# rerank 保底：最终 Top-K 里为「融合排序（向量 + BM25）的前 N 名」保留位置。
#
# 为什么需要：rerank 只会给片段加分，但排名是相对的 —— 它把别的片段抬高，
# 同样能把正确条款挤出 Top-K；而融合排序是两个召回通道的共同判断，不该被一次
# rerank 调用整个抹掉。占用名额而不是额外追加，所以返回条数仍是 TOP_K，
# 也永远不会挤掉 rerank 的第 1 名。
#
# 代价：会稀释 rerank 的判断。换成 rerank 明显强于融合排序的语料时应调小或设 0。
# 0 = 完全听 rerank。
# 默认 1：只给融合排序的第 1 名留一个位置，在"保底"和"少稀释"之间取折中。
RERANK_KEEP_FUSION_TOP_N=1

# ============ 短期记忆压缩 ============
# 主问答链路读全量历史后按下面两个参数压缩：
# 超过 TRIGGER 条时把更早的对话交给模型压成摘要，只保留最近 KEEP 条原文。
HISTORY_SUMMARY_TRIGGER_MESSAGES=6
HISTORY_SUMMARY_KEEP_MESSAGES=2

# ============ 查询改写 ============
# 多 Query 改写（口语 → 制度语体）。**这是"口语提问能不能召回"的关键一步**：
# 员工不会用制度里的原词提问，口语说法与制度正文几乎没有共同字串，
# 两种检索通道都够不着；改写成制度语体后目标条款才能被召回。
# 平台配置（系统管理员账号）同样生效；关掉可以省掉每题一次 LLM 调用。
QUERY_REWRITE_ENABLED=true
# 多路检索最多保留几个候选查询。
QUERY_REWRITE_MAX_QUERIES=3
# 改写与拆子问题的温度，固定 0：这两次调用要的是稳定，不要发挥。
# 调高会让同一问题每次检索到的证据都不一样（结果不可复现，甚至一次拒答一次编造）。
# 答案生成走 DEEPSEEK_TEMPERATURE，不受这里影响。
QUERY_REWRITE_TEMPERATURE=0
# 单次检索最多发几条 Query（原问题 + LLM 改写 + 拆出的子问题），控制 embedding 调用次数。
RETRIEVAL_MAX_QUERIES=5
# 一问多求（一句话问了两件以上事）是否先拆成子问题各自检索。
QUERY_DECOMPOSE_ENABLED=true

# ============ RAGAS 辅助指标 ============
# RAGAS 只作为辅助参考，不决定评测通过率；默认值一般不用改。
RAGAS_FAITHFULNESS_THRESHOLD=0.8
RAGAS_CONTEXT_RECALL_THRESHOLD=0.7
RAGAS_FACTUAL_CORRECTNESS_THRESHOLD=0.7
RAGAS_ANSWER_RELEVANCY_THRESHOLD=0.75

# ============ 模型调用超时与重试 ============
# 360 题评测要发几千次外部请求，长跑中网络抖动躲不掉，显式配置比用 SDK 默认值可控。
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
# 评测链路对「工程失败」（超时、断连、限流、5xx）的最大尝试次数（含首次，即首次 + 2 次重试）与退避基数（秒）。
# 工程失败不代表 RAG 能力，不会计入能力指标的分母，但仍会在报告里单独展示。
EVALUATION_API_RETRY_ATTEMPTS=3
EVALUATION_API_RETRY_BASE_DELAY=2.0

# ============ 中间件开关（P1 进阶）============
# true=问答 Agent 启用 PII 脱敏 + 对话摘要；false=关闭（可对比效果）
ENABLE_MIDDLEWARE=true
# 文档后台处理并发数。线上 2核4G 推荐 1，让批量上传排队处理。
DOCUMENT_PROCESS_CONCURRENCY=1

# 认证配置
# 上线前请替换为强随机字符串；本地开发可不填，后端会使用开发默认值。
AUTH_SECRET_KEY=change-me-before-deploy
AUTH_TOKEN_EXPIRE_DAYS=7

# ============ 系统管理员初始账号（可选）============
# 首次建库时用这个口令自动创建系统管理员。**留空则不创建**，请按需填写，不要提交真实口令。
# 已存在的同名账号不会被覆盖，改密码要直接在数据库里处理。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
