# Application
APP_NAME=RAG Business Chat
APP_ENV=development
DEBUG=true

# Database: sqlite is easiest for local demo; MySQL is recommended for production.
DB_DRIVER=sqlite
SQLITE_DB_PATH=./backend/data/app.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rag_business_chat
MYSQL_USER=rag_user
MYSQL_PASSWORD=replace-with-your-db-password

# Auth
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform model fallback for local development only.
# In SaaS mode, configure DeepSeek and SiliconFlow keys in the web admin console.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=replace-with-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Zilliz / Milvus
ZILLIZ_URI=replace-with-your-zilliz-uri
ZILLIZ_TOKEN=replace-with-your-zilliz-token
ZILLIZ_COLLECTION=knowledge_chunks

# LangSmith tracing is disabled by default to avoid quota noise during demos/tests.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
