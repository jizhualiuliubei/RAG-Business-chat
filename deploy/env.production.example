APP_NAME=RAG Business Chat
APP_ENV=production
DEBUG=false

DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rag_business_chat
MYSQL_USER=rag_user
MYSQL_PASSWORD=replace-with-strong-password
AUTH_SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configure production model keys from the web admin console when possible.
# These values are only a bootstrap fallback for the system tenant.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=replace-with-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

ZILLIZ_URI=replace-with-your-zilliz-uri
ZILLIZ_TOKEN=replace-with-your-zilliz-token
ZILLIZ_COLLECTION=knowledge_chunks
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
