# 线上部署环境变量模板
# 使用方式：复制到项目根目录 .env 后替换真实值。不要提交真实 .env。

# DeepSeek 对话模型
DEEPSEEK_API_KEY=请替换为真实 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 硅基流动嵌入模型 BGE-M3
SILICONFLOW_API_KEY=请替换为真实硅基流动 API Key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Milvus / Zilliz Cloud 向量数据库
# 低配服务器推荐 Zilliz Cloud Free：填公共 Endpoint，并把 token 填为 API Key 或 username:password。
MILVUS_URI=https://<你的实例ID>.serverless.<你的区域>.cloud.zilliz.com.cn
MILVUS_TOKEN=
MILVUS_DB_NAME=<你的数据库名>
MILVUS_COLLECTION=knowledge_chunks

# MySQL 关系数据库
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请替换为强数据库密码
DB_NAME=kb_qa
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=60

# 应用参数
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024
CHUNK_SIZE=350
CHUNK_OVERLAP=80
TOP_K=5
SCORE_THRESHOLD=0.45
# 短期记忆压缩：超过 TRIGGER 条时把更早对话压成摘要，保留最近 KEEP 条原文
HISTORY_SUMMARY_TRIGGER_MESSAGES=6
HISTORY_SUMMARY_KEEP_MESSAGES=2
ENABLE_MIDDLEWARE=true
MAX_FILE_SIZE=20971520
DOCUMENT_PROCESS_CONCURRENCY=1

# 认证配置
AUTH_SECRET_KEY=请替换为强随机字符串
AUTH_TOKEN_EXPIRE_DAYS=7
